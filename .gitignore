# Environment files — never commit
.env
*.env
*.env.local

# Python
__pycache__/
*.pyc
*.pyo
backend/venv/
backend/*.db

# PyInstaller (sidecar build artifacts)
backend/build/
backend/dist/
backend/*.spec

# Node
node_modules/
frontend/dist/
frontend/.vercel/

# Tauri / Rust build output
frontend/src-tauri/target/
frontend/src-tauri/gen/
frontend/src-tauri/binaries/chefos-backend*

# Claude Code internal files
.claude/

# Editor
.vscode/

# Large zip / archive files
*.zip
*.rar
*.7z

# OS files
.DS_Store
Thumbs.db

# Local dev launcher (contains keys)
run-local.ps1

# Runtime data (generated by the running app — never commit)
backend/backups/
backups/
backend/branding.json
backend/mobile_access.json
backend/chefos.license
updater-private.key
updater-private.key.pub

# Generated per-release (upload to GitHub, do not commit)
latest.json

