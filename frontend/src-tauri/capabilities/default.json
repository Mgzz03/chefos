{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ChefOS desktop capability — allows spawning the bundled backend sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/chefos-backend", "sidecar": true }]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/chefos-backend", "sidecar": true }]
    },
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}
