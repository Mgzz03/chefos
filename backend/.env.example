# ── 1. Supabase PostgreSQL connection ─────────────────────
# Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.vmmbtwrtujfffzinyxcf.supabase.co:5432/postgres

# ── 2. Supabase JWT secret (verifies user tokens) ─────────
# Supabase → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── 3. CORS — allowed frontend origins ────────────────────
# Add your Vercel URL here once you have it (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://YOUR-APP.vercel.app

# ── 4. Reference only (not used by backend directly) ──────
SUPABASE_URL=https://vmmbtwrtujfffzinyxcf.supabase.co
